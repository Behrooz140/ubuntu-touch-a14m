# Minimal Halium config fragment for a14m (MT6768, kernel 6.6)
# Merged on top of the stock defconfig. Keep this file small and readable;
# full device-specific config is kernel/config.a14m.stock (reference only).

CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y

# Already present in the live kernel config; listed here to make the
# requirement explicit and to detect accidental loss in a future defconfig:
CONFIG_ASHMEM=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_OVERLAY_FS=y
CONFIG_MODULES=y
