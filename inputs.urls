# Download URLs for the files listed in inputs.sha256.
# Format: <filename><whitespace><url>
# Lines beginning with # are ignored. INPUTS_MIRROR overrides the URL host/path
# with "${INPUTS_MIRROR%/}/<filename>" for every entry.

